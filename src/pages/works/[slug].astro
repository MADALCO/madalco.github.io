---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const works = await getCollection("works");
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const d = work.data;
const { Content } = await render(work);
const no = String(d.no).padStart(3, "0");
---

<Base title={d.title} description={`${d.tagline} ${d.genre}`} image={d.poster} tone="dark">
  <div
    class="work"
    style={`--w-bg:${d.palette.bg};--w-fg:${d.palette.fg};--w-a:${d.palette.accent};--w-a2:${d.palette.accent2}`}
  >
    <section class="cover">
      {
        d.loop ? (
          <video src={d.loop} poster={d.poster} autoplay muted loop playsinline preload="auto" />
        ) : (
          <img src={d.poster} alt="" />
        )
      }
      <span class="cover-shade"></span>
      <div class="cover-in wrap">
        <div class="cover-meta mono">
          <a href="/works/" class="ul">← Works</a>
          <span>Work {no}</span>
          <span>{d.year}</span>
          <span class="st">{d.status}</span>
        </div>
        <h1 class:list={{ custom: d.titleFont }} style={d.titleFont && `font-family:"${d.titleFont}",var(--f-display)`}>
          {d.title}
        </h1>
        <p class="tag">{d.tagline}</p>
      </div>
    </section>

    <section class="intro wrap">
      <dl class="spec mono">
        <div><dt>Genre</dt><dd>{d.genre}</dd></div>
        <div><dt>Players</dt><dd>{d.players}</dd></div>
        <div><dt>Platform</dt><dd>{d.platforms.join(" / ")}</dd></div>
        <div><dt>Engine</dt><dd>{d.engine}</dd></div>
        <div><dt>Status</dt><dd>{d.status}</dd></div>
      </dl>
      <div class="prose" data-reveal>
        <Content />
      </div>
      <ul class="links mono">
        {
          d.links.map((l) =>
            l.href ? (
              <li>
                <a href={l.href} rel="noopener" class="btn">
                  {l.label} ↗
                </a>
              </li>
            ) : (
              <li>
                <span class="btn off">
                  {l.label}
                  <em>{l.note}</em>
                </span>
              </li>
            ),
          )
        }
      </ul>
    </section>

    {
      d.trailer && (
        <section class="trailer wrap" data-reveal>
          <p class="mono lbl">Trailer</p>
          <video src={d.trailer} poster={d.trailerPoster} controls preload="none" playsinline />
        </section>
      )
    }

    {
      d.features.length > 0 && (
        <section class="feats wrap">
          <p class="mono lbl">Features</p>
          <ol>
            {d.features.map((f, i) => (
              <li data-reveal>
                <span class="n mono">{String(i + 1).padStart(2, "0")}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      d.gallery.length > 0 && (
        <section class="gallery wrap">
          <p class="mono lbl">Screens</p>
          <div class="g">
            {d.gallery.map((g, i) => (
              <figure data-reveal class={i === 0 ? "wide" : ""}>
                <img src={g.src} alt={g.caption} loading="lazy" />
                <figcaption class="mono">
                  <span>{String(i + 1).padStart(2, "0")}</span>
                  {g.caption}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <div class="tail wrap">
      <a href="/works/" class="mono ul">← All works</a>
      <a href="/privacy/" class="mono ul">Privacy policy</a>
    </div>
  </div>
</Base>

<style>
  .work {
    background: var(--w-bg);
    color: var(--w-fg);
    padding-bottom: 60px;
    margin-top: -52px;
  }
  :global(body.tone-dark) {
    background: #08090a;
    background-image: none;
  }
  :global(body.tone-dark .foot) {
    color: #d9d7cf;
    margin-top: 0;
    padding-top: 60px;
  }
  :global(body.tone-dark .foot .rule) {
    border-color: rgba(255, 255, 255, 0.5);
  }
  :global(body.tone-dark .foot p),
  :global(body.tone-dark .foot .lbl) {
    color: rgba(255, 255, 255, 0.5);
  }
  .cover {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
  }
  .cover video,
  .cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.45), transparent 22%),
      linear-gradient(0deg, var(--w-bg) 2%, transparent 55%);
  }
  .cover-in {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding-bottom: clamp(28px, 5vw, 64px);
  }
  .cover-meta {
    display: flex;
    gap: 22px;
    padding-bottom: 14px;
    border-bottom: 1px solid color-mix(in srgb, var(--w-fg) 45%, transparent);
  }
  .st {
    margin-left: auto;
    color: var(--w-a);
  }
  h1 {
    margin: 16px 0 0;
    font-family: var(--f-display);
    font-weight: 800;
    font-variation-settings: "wdth" 125;
    font-size: calc((100vw - var(--gutter) * 2) * 0.104);
    line-height: 0.86;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  h1.custom {
    font-weight: 400;
    font-variation-settings: normal;
    letter-spacing: 0;
    line-height: 1;
    font-size: calc((100vw - var(--gutter) * 2) * 0.112);
  }
  .tag {
    margin: 18px 0 0;
    font-size: clamp(17px, 1.8vw, 26px);
    font-weight: 500;
  }

  .intro {
    display: grid;
    grid-template-columns: 4fr 6fr 2fr;
    gap: var(--gutter);
    padding-top: clamp(40px, 6vw, 90px);
  }
  .spec {
    margin: 0;
    border-top: 1px solid color-mix(in srgb, var(--w-fg) 35%, transparent);
  }
  .spec div {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--w-fg) 35%, transparent);
  }
  .spec dt {
    opacity: 0.55;
  }
  .spec dd {
    margin: 0;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .prose {
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 2;
  }
  .prose :global(p) {
    margin: 0 0 1.3em;
  }
  .prose :global(p:first-child) {
    font-size: 1.35em;
    line-height: 1.7;
    font-weight: 700;
    color: var(--w-a);
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .btn {
    display: flex;
    justify-content: space-between;
    padding: 12px 14px;
    border: 1px solid var(--w-fg);
  }
  .btn.off {
    border-style: dashed;
    opacity: 0.6;
  }
  .btn em {
    font-style: normal;
    opacity: 0.8;
  }
  a.btn:hover {
    background: var(--w-fg);
    color: var(--w-bg);
  }

  .lbl {
    opacity: 0.6;
    margin: 0 0 16px;
    padding-top: 14px;
    border-top: 1px solid color-mix(in srgb, var(--w-fg) 35%, transparent);
  }
  .trailer {
    margin-top: clamp(70px, 9vw, 130px);
  }
  .trailer video {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .feats {
    margin-top: clamp(70px, 9vw, 130px);
  }
  .feats ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    border-left: 1px solid color-mix(in srgb, var(--w-fg) 25%, transparent);
  }
  .feats li {
    padding: 4px 22px 26px;
    border-right: 1px solid color-mix(in srgb, var(--w-fg) 25%, transparent);
  }
  .feats .n {
    color: var(--w-a);
  }
  .feats h3 {
    margin: 26px 0 10px;
    font-size: 19px;
  }
  .feats p {
    margin: 0;
    font-size: 14px;
    opacity: 0.8;
  }

  .gallery {
    margin-top: clamp(70px, 9vw, 130px);
  }
  .g {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .g figure {
    margin: 0;
  }
  .g .wide {
    grid-column: 1 / -1;
  }
  .g img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .g figcaption {
    display: flex;
    gap: 12px;
    padding-top: 8px;
    opacity: 0.7;
    text-transform: none;
  }

  .tail {
    display: flex;
    justify-content: space-between;
    margin-top: 80px;
  }

  @media (max-width: 860px) {
    .intro {
      grid-template-columns: 1fr;
    }
    .g {
      grid-template-columns: 1fr;
    }
    .cover-meta span:not(.st) {
      display: none;
    }
  }
</style>
