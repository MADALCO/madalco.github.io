---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SonarGrid from "../components/SonarGrid.astro";
import WorkPlate from "../components/WorkPlate.astro";

const works = (await getCollection("works")).sort((a, b) => b.data.no - a.data.no);
const nextNo = String(Math.max(0, ...works.map((w) => w.data.no)) + 1).padStart(3, "0");
---

<Base>
  <section class="hero wrap">
    <div class="meta mono">
      <span>Independent game works</span>
      <span>Est. 2026</span>
      <span>Works {String(works.length).padStart(3, "0")}</span>
      <span class="hide-sm">Made in Japan</span>
    </div>

    <h1 class="word" aria-label="madalco">
      <span>madalco</span>
    </h1>

    <div class="lede">
      <div class="lede-text" data-reveal>
        <p class="mono idx">Statement</p>
        <p class="big">
          遊びは、<br />ルールの<em>手ざわり</em>で<br />決まると思う。
        </p>
        <p class="small">
          madalco は、ひとりでゲームを作っています。まず紙とマス目でルールを組み、それが面白くなってから絵と音をのせる。手で触ってすぐに分かって、何度も考えたくなる。そういう小さなゲームを、一本ずつ出していきます。
        </p>
      </div>
      <div class="lede-play" data-reveal>
        <SonarGrid />
      </div>
    </div>
  </section>

  <section class="works" id="works">
    <div class="sec-head wrap">
      <p class="mono idx">Works</p>
      <h2>作品</h2>
      <a href="/works/" class="mono ul all">Index of all works →</a>
    </div>
    {works.map((w) => <WorkPlate work={w} />)}
    <div class="next wrap" data-reveal>
      <span class="mono">Work {nextNo}</span>
      <span class="next-t">次の作品を、マス目の上で考えています。</span>
      <span class="mono dim">In development</span>
    </div>
  </section>

</Base>

<style>
  .hero {
    padding-top: 18px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--ink-2);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .word {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 800;
    font-variation-settings: "wdth" 125;
    /* 画面幅いっぱいに収まる大きさ */
    font-size: calc((100vw - var(--gutter) * 2) * 0.198);
    line-height: 0.78;
    letter-spacing: -0.055em;
    padding: 0.08em 0 0.06em;
    border-bottom: 1px solid var(--rule-strong);
    white-space: nowrap;
    overflow: hidden;
  }
  .word span {
    display: inline-block;
    transform: translateX(-0.04em);
    animation: rise 1.1s cubic-bezier(0.2, 0.7, 0.1, 1) both;
  }
  @keyframes rise {
    from {
      transform: translate(-0.04em, 0.5em);
      clip-path: inset(0 0 100% 0);
    }
    to {
      transform: translate(-0.04em, 0);
      clip-path: inset(0 0 0 0);
    }
  }
  .lede {
    display: grid;
    grid-template-columns: 6fr 6fr;
    gap: var(--gutter);
    padding: clamp(36px, 6vw, 88px) 0 clamp(60px, 9vw, 130px);
  }
  .lede-play {
    justify-self: end;
  }
  .idx {
    color: var(--ink-3);
    margin: 0 0 18px;
  }
  .big {
    margin: 0;
    font-size: clamp(30px, 4.1vw, 60px);
    line-height: 1.32;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .big em {
    font-style: normal;
    color: var(--signal);
  }
  .small {
    margin: 28px 0 0;
    max-width: 30em;
    color: var(--ink-2);
  }

  .sec-head {
    display: grid;
    grid-template-columns: 3fr 6fr 3fr;
    align-items: baseline;
    gap: var(--gutter);
    padding-bottom: 18px;
    border-top: 1px solid var(--rule-strong);
    padding-top: 14px;
  }
  .works > .sec-head {
    margin-inline: var(--gutter);
    padding-inline: 0;
  }
  .sec-head .idx {
    margin: 0;
  }
  .sec-head h2 {
    margin: 0;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 700;
  }
  .all {
    justify-self: end;
  }
  .next {
    display: grid;
    grid-template-columns: 3fr 6fr 3fr;
    gap: var(--gutter);
    align-items: center;
    padding-top: 26px;
    padding-bottom: 26px;
    border-bottom: 1px dashed var(--rule-strong);
    margin-inline: var(--gutter);
    padding-inline: 0;
  }
  .next-t {
    color: var(--ink-2);
  }
  .dim {
    color: var(--ink-3);
    justify-self: end;
  }


  @media (max-width: 860px) {
    .lede {
      grid-template-columns: 1fr;
    }
    .lede-play {
      justify-self: start;
    }
    .sec-head,
    .next {
      grid-template-columns: 1fr 1fr;
    }
    .sec-head h2 {
      grid-column: 1 / -1;
      order: 3;
    }
    .next-t {
      grid-column: 1 / -1;
      order: 3;
    }
    .hide-sm {
      display: none;
    }
  }
</style>
