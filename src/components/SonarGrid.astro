---
// トップの小さな遊び: 6×6 の海に艦が 2 隻。外れたマスには周り 8 マスの反応数が出る。
const cols = ["A", "B", "C", "D", "E", "F"];
const rows = [1, 2, 3, 4, 5, 6];
---

<div class="sonar" data-sonar>
  <div class="sonar-head mono">
    <span>Sonar / 6×6</span>
    <span data-status>Click a cell</span>
  </div>
  <div class="board" role="grid" aria-label="ソナーの盤面。マスを押して艦を探す">
    <span class="corner" aria-hidden="true"></span>
    {cols.map((c) => <span class="axis mono" aria-hidden="true">{c}</span>)}
    {
      rows.map((r) => (
        <>
          <span class="axis mono" aria-hidden="true">
            {r}
          </span>
          {cols.map((c, ci) => (
            <button class="cell" type="button" data-x={ci} data-y={r - 1} aria-label={`${c}${r}`}>
              <span class="v mono" />
            </button>
          ))}
        </>
      ))
    }
  </div>
  <ol class="log mono" data-log aria-live="polite"></ol>
  <a class="done mono" href="/works/submarine-3d/" data-done hidden>
    全艦撃沈。深さのある海は <b>SUBMARINE 3D</b> で →
  </a>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-sonar]")) {
      const N = 6;
      const cells = [...root.querySelectorAll<HTMLButtonElement>(".cell")];
      const status = root.querySelector<HTMLElement>("[data-status]")!;
      const log = root.querySelector<HTMLOListElement>("[data-log]")!;
      const done = root.querySelector<HTMLAnchorElement>("[data-done]")!;
      const ships = new Set<string>();
      const key = (x: number, y: number) => `${x},${y}`;

      // 長さ 3 と 2 の艦を重ならないように置く
      for (const len of [3, 2]) {
        for (;;) {
          const h = Math.random() < 0.5;
          const x = Math.floor(Math.random() * (h ? N - len + 1 : N));
          const y = Math.floor(Math.random() * (h ? N : N - len + 1));
          const ks = Array.from({ length: len }, (_, i) => key(h ? x + i : x, h ? y : y + i));
          if (ks.some((k) => ships.has(k))) continue;
          ks.forEach((k) => ships.add(k));
          break;
        }
      }
      const total = ships.size;
      let hits = 0;
      let shots = 0;

      const near = (x: number, y: number) => {
        let n = 0;
        for (let dy = -1; dy <= 1; dy++)
          for (let dx = -1; dx <= 1; dx++) if (ships.has(key(x + dx, y + dy))) n++;
        return n;
      };

      const write = (text: string) => {
        const li = document.createElement("li");
        li.textContent = text;
        log.prepend(li);
        while (log.children.length > 4) log.lastElementChild!.remove();
      };

      for (const cell of cells) {
        const x = Number(cell.dataset.x);
        const y = Number(cell.dataset.y);
        const name = cell.getAttribute("aria-label");
        cell.addEventListener("pointerenter", () => {
          root.style.setProperty("--hx", String(x));
          root.style.setProperty("--hy", String(y));
          root.classList.add("hovering");
        });
        cell.addEventListener("pointerleave", () => root.classList.remove("hovering"));
        cell.addEventListener("click", () => {
          if (cell.dataset.state) return;
          shots++;
          cell.classList.add("ping");
          if (ships.has(key(x, y))) {
            hits++;
            cell.dataset.state = "hit";
            write(`${String(shots).padStart(2, "0")}  ${name}  HIT`);
          } else {
            const n = near(x, y);
            cell.dataset.state = "miss";
            cell.querySelector(".v")!.textContent = String(n);
            write(`${String(shots).padStart(2, "0")}  ${name}  ECHO ${n}`);
          }
          status.textContent = `${hits}/${total} hit · ${shots} shots`;
          if (hits === total) {
            root.classList.add("cleared");
            done.hidden = false;
            for (const c of cells) if (!c.dataset.state) c.disabled = true;
          }
        });
      }
    }
  });
</script>

<style>
  .sonar {
    --cell: clamp(34px, 5.2vw, 62px);
    --line: rgba(19, 20, 17, 0.22);
    width: max-content;
    max-width: 100%;
  }
  .sonar-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    margin-left: 22px;
    color: var(--ink-2);
  }
  .board {
    display: grid;
    grid-template-columns: 22px repeat(6, var(--cell));
    grid-template-rows: 22px repeat(6, var(--cell));
    position: relative;
  }
  .axis {
    display: grid;
    place-items: center;
    color: var(--ink-3);
    font-size: 10px;
  }
  .cell {
    position: relative;
    appearance: none;
    border: 0;
    margin: 0;
    padding: 0;
    background: transparent;
    box-shadow:
      inset 1px 0 0 var(--line),
      inset 0 1px 0 var(--line);
    cursor: crosshair;
    color: var(--ink);
    transition: background-color 0.25s ease;
  }
  /* 右端と下端の線 */
  .cell[data-x="5"] {
    box-shadow:
      inset 1px 0 0 var(--line),
      inset 0 1px 0 var(--line),
      inset -1px 0 0 var(--line);
  }
  .cell[data-y="5"] {
    box-shadow:
      inset 1px 0 0 var(--line),
      inset 0 1px 0 var(--line),
      inset 0 -1px 0 var(--line);
  }
  .cell[data-x="5"][data-y="5"] {
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .cell:hover:not([data-state]):not(:disabled) {
    background: rgba(19, 20, 17, 0.07);
  }
  .cell .v {
    font-size: 12px;
    color: var(--ink-2);
  }
  .cell[data-state="hit"] {
    background: var(--signal);
  }
  .cell.ping::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    margin: -5px;
    border: 1px solid var(--signal);
    border-radius: 50%;
    pointer-events: none;
    animation: ping 0.9s cubic-bezier(0.1, 0.6, 0.2, 1) forwards;
  }
  .cell:disabled {
    cursor: default;
    opacity: 0.4;
  }
  @keyframes ping {
    to {
      transform: scale(14);
      opacity: 0;
    }
  }
  /* カーソルの十字線 */
  .board::before,
  .board::after {
    content: "";
    position: absolute;
    pointer-events: none;
    background: var(--signal);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .board::before {
    left: 22px;
    right: 0;
    height: 1px;
    top: calc(22px + (var(--hy, 0) + 0.5) * var(--cell));
  }
  .board::after {
    top: 22px;
    bottom: 0;
    width: 1px;
    left: calc(22px + (var(--hx, 0) + 0.5) * var(--cell));
  }
  .sonar.hovering:not(.cleared) .board::before,
  .sonar.hovering:not(.cleared) .board::after {
    opacity: 0.35;
  }
  .log {
    list-style: none;
    margin: 14px 0 0 22px;
    padding: 0;
    min-height: 4.5em;
    color: var(--ink-2);
    white-space: pre;
  }
  .log li:first-child {
    color: var(--ink);
  }
  .done {
    display: inline-block;
    margin: 8px 0 0 22px;
    padding: 8px 12px;
    background: var(--ink);
    color: var(--paper);
    text-transform: none;
  }
  .done[hidden] {
    display: none;
  }
  .done b {
    font-weight: 500;
    color: var(--signal);
  }
  @media (prefers-reduced-motion: reduce) {
    .cell.ping::after {
      animation: none;
      display: none;
    }
  }
</style>
