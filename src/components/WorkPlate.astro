---
// 作品 1 つ分の大きな板。色は作品ごとの palette から取る。
import type { CollectionEntry } from "astro:content";
interface Props {
  work: CollectionEntry<"works">;
}
const { work } = Astro.props;
const d = work.data;
const no = String(d.no).padStart(3, "0");
const href = `/works/${work.id}/`;
---

<article
  class="plate"
  style={`--w-bg:${d.palette.bg};--w-fg:${d.palette.fg};--w-a:${d.palette.accent};--w-a2:${d.palette.accent2}`}
>
  <a href={href} class="plate-link" aria-label={`${d.title} の詳細`}>
    <div class="media">
      {
        d.loop ? (
          <video src={d.loop} poster={d.poster} autoplay muted loop playsinline preload="metadata" />
        ) : (
          <img src={d.poster} alt="" loading="lazy" />
        )
      }
      <span class="shade"></span>
    </div>
    <div class="body">
      <div class="row mono">
        <span>Work {no}</span>
        <span>{d.year}</span>
        <span class="st">{d.status}</span>
      </div>
      <h3 class="title">{d.title}</h3>
      <p class="tag">{d.tagline}</p>
      <dl class="spec mono">
        <div><dt>Genre</dt><dd>{d.genre}</dd></div>
        <div><dt>Players</dt><dd>{d.players}</dd></div>
        <div><dt>Platform</dt><dd>{d.platforms.join(" / ")}</dd></div>
      </dl>
      <span class="go mono">View work <span class="arr">→</span></span>
    </div>
  </a>
</article>

<style>
  .plate {
    background: var(--w-bg);
    color: var(--w-fg);
    position: relative;
    overflow: hidden;
  }
  .plate-link {
    display: grid;
    grid-template-columns: 7fr 5fr;
    min-height: min(78vh, 760px);
  }
  .media {
    position: relative;
    overflow: hidden;
  }
  .media video,
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .plate-link:hover .media video,
  .plate-link:hover .media img {
    transform: scale(1.06);
  }
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 55%, var(--w-bg));
  }
  .body {
    display: flex;
    flex-direction: column;
    padding: clamp(22px, 3vw, 44px);
    position: relative;
  }
  .row {
    display: flex;
    gap: 18px;
    opacity: 0.75;
  }
  .st {
    margin-left: auto;
    color: var(--w-a);
    opacity: 1;
  }
  .st::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    background: var(--w-a);
    border-radius: 50%;
    vertical-align: 1px;
    animation: blink 2.4s steps(2, jump-none) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }
  .title {
    margin: auto 0 0;
    padding-top: 40px;
    font-family: var(--f-display);
    font-weight: 800;
    font-variation-settings: "wdth" 125;
    font-size: clamp(40px, 5.6vw, 92px);
    line-height: 0.9;
    letter-spacing: -0.035em;
  }
  .tag {
    margin: 18px 0 0;
    font-size: clamp(15px, 1.4vw, 19px);
  }
  .spec {
    margin: 32px 0 0;
    border-top: 1px solid color-mix(in srgb, var(--w-fg) 30%, transparent);
  }
  .spec div {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--w-fg) 30%, transparent);
  }
  .spec dt {
    opacity: 0.6;
  }
  .spec dd {
    margin: 0;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .go {
    margin-top: 28px;
    align-self: flex-start;
    padding: 12px 16px;
    border: 1px solid var(--w-fg);
    transition:
      background 0.25s,
      color 0.25s;
  }
  .arr {
    display: inline-block;
    transition: transform 0.3s;
  }
  .plate-link:hover .go {
    background: var(--w-fg);
    color: var(--w-bg);
  }
  .plate-link:hover .arr {
    transform: translateX(4px);
  }
  @media (max-width: 860px) {
    .plate-link {
      grid-template-columns: 1fr;
    }
    .media {
      aspect-ratio: 16 / 10;
    }
    .shade {
      background: linear-gradient(180deg, transparent 60%, var(--w-bg));
    }
  }
</style>
